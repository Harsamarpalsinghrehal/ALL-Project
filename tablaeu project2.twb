      <column caption='Letter Grade' datatype='string' name='[Calculation_0651236116467715]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0750466843688967] &gt; 90 THEN &quot;A (90-100)&quot;&#13;&#10;ELSEIF [Calculation_0750466843688967] &gt; 80 THEN &quot;B (80-89)&quot;&#13;&#10;ELSEIF [Calculation_0750466843688967] &gt; 70 THEN &quot;C (70-79)&quot;&#13;&#10;ELSEIF [Calculation_0750466843688967] &gt; 60 THEN &quot;D (60-69)&quot;&#13;&#10;ELSE &quot;F (&lt;60)&quot;&#13;&#10;END' />
      </column>
      <column caption='Is_passing' datatype='string' name='[Calculation_0651236118134788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0750466843688967] &gt;=60 THEN &quot;Pass&quot;&#13;&#10;ELSE &quot;At Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='Parent Edu Clean' datatype='string' name='[Calculation_0651236121677829]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([ParentEduc], &quot;is not specified&quot; )' />
      </column>
      <column caption='Study Hours Clean' datatype='string' name='[Calculation_0651236126208006]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [WklyStudyHours]=&quot;&lt; 5&quot; then &quot;Less than 5 hrs&quot;&#13;&#10; ELSEIF [WklyStudyHours]=&quot;&gt; 10&quot; then &quot;Greater than 10 hrs&quot;&#13;&#10; ELSEIF [WklyStudyHours]=&quot;05-Oct&quot; then &quot;Between 5 to 10 hrs&quot;&#13;&#10; ELSE &quot;Not Specified&quot;&#13;&#10; END' />
      </column>
      <column caption='Ethnic Group Clean' datatype='string' name='[Calculation_0750466829717504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([EthnicGroup],&quot;Not Specified&quot;)' />
      </column>
      <column caption='Test Prep Clean' datatype='string' name='[Calculation_0750466831097857]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TestPrep]=&quot;completed&quot; THEN &quot;Test Prep completed&quot;&#13;&#10;ELSE &quot;Test Prep Not completed&quot;&#13;&#10;END' />
      </column>
      <column caption='Parent Marital Status Clean ' datatype='string' name='[Calculation_0750466832359426]' role='dimension' type='nominal'>
